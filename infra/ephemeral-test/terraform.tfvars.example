# Copy to terraform.tfvars and fill in, OR just export TF_VAR_do_token etc. — run.sh only requires
# TF_VAR_do_token to be set (as an env var) and derives allowed_ssh_cidr itself. This file exists for
# anyone who wants to run terraform directly instead of via run.sh, or override a default.
#
# terraform.tfvars itself is gitignored (see ../../.gitignore) — never commit real values.

# do_token        = "dop_v1_..."          # required; prefer TF_VAR_do_token instead of writing it here
# region          = "nyc3"
# droplet_size    = "s-8vcpu-16gb"        # ~$0.14/hr — or "s-4vcpu-8gb" (~$0.07/hr) for lighter tests
# droplet_image   = "ubuntu-24-04-x64"
# name_prefix     = "odp-ephemeral"
# allowed_ssh_cidr = "203.0.113.4/32"     # required; run.sh sets this for you via TF_VAR_allowed_ssh_cidr
