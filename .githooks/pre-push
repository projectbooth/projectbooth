#!/usr/bin/env bash
# Blocks direct pushes to protected branches (main, test, dev) on the
# remote — the second layer, in case a commit landed on one of them
# anyway (a rebase, a --no-verify commit, a branch merged locally by hand).
# Land changes on protected branches only via a merged PR on GitHub.
#
# Bypass (rare): git push --no-verify

remote="$1"
protected_refs="refs/heads/(main|test|dev)$"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" =~ $protected_refs ]]; then
    branch="${BASH_REMATCH[1]}"
    echo ""
    echo "Direct push to '$branch' on '$remote' blocked."
    echo "  Open a pull request instead."
    echo ""
    echo "  Really mean it? git push --no-verify"
    echo ""
    exit 1
  fi
done

exit 0
