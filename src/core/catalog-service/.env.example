# Copy to .env for local dev (uvicorn/alembic both read this via
# app/config.py's pydantic-settings — .env is in .gitignore-equivalent
# territory, never commit a real one).
#
# In-cluster, this is never a file — bootstrap/install.sh generates
# platform-postgres-catalog-credentials (postgres namespace) and Reflector
# mirrors it into catalog-service; ../../argocd/manifests/catalog-service.yaml's
# Deployment reads PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD from that
# Secret instead of a single DATABASE_URL — see app/config.py's docstring
# for why (the generated password isn't URL-safe to splice in directly).
# Locally, a single DATABASE_URL is simpler and fine — you picked this
# password yourself.

DATABASE_URL=postgresql+psycopg://catalog:catalog-dev-password@localhost:5432/catalog

# Space-separated list of allowed CORS origins — only matters if you're
# running catalog-service standalone for local dev, reached directly by a
# browser. Unset/empty in-cluster, and not for the reason an earlier
# version of this comment assumed (a same-origin gateway proxy):
# ui-shell-plan.md item 2 (feature/gateway-cors-ui-shell, 2026-09-08)
# decided the other way — ui-shell keeps its own Ingress host and gateway
# handles CORS itself (see gateway/.env.example's GATEWAY_CORS_ORIGINS).
# This stays unset in-cluster because catalog-service is never reached
# directly by a browser there regardless: a NetworkPolicy
# (manifests/catalog-service.yaml) restricts its ingress to the `gateway`
# namespace only — see docs/known-issues.md's "catalog-service's auth was a
# placeholder" entry.
CORS_ORIGINS=http://localhost:5173
