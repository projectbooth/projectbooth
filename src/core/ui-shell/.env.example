# Copy to .env for `npm run dev` — same convention as gateway's and
# catalog-service's own .env.example, even though the values below are
# identical to .env.production's, not different ones. That's not a copy-
# paste mistake: unlike gateway/catalog-service (which differ local-vs-
# cluster because of NetworkPolicy and port-forwarding), Keycloak's
# hostname-strict behavior means local ui-shell dev talks to the exact same
# cluster Keycloak the CLI's `platform login` already does — an /etc/hosts
# entry pointing keycloak.platform.local at the real cluster IP (see
# docs/known-issues.md's "Reaching Keycloak by raw IP" entry), no
# port-forward involved. bootstrap/keycloak-bootstrap-ui-shell-client.sh
# registers BOTH http://localhost:5173/auth/callback (this) and
# https://app.platform.local/auth/callback (the deployed build) as valid
# redirect URIs on the same Keycloak client, so no separate client/config is
# needed for local dev.

VITE_KEYCLOAK_URL=https://keycloak.platform.local
VITE_KEYCLOAK_REALM=platform
VITE_KEYCLOAK_CLIENT_ID=platform-ui-shell

# item 5, ui-shell-plan.md — same identical-local-vs-cluster reasoning as the
# three VITE_KEYCLOAK_* values above: gateway.platform.local is the same real
# cluster gateway either way, reachable locally over the same /etc/hosts
# entry item 3 already required.
VITE_GATEWAY_URL=https://gateway.platform.local
