# Copy to .env for local dev (uvicorn reads this via app/config.py's
# pydantic-settings — .env is in .gitignore-equivalent territory, never
# commit a real one). All GATEWAY_* — see app/config.py's docstring for why
# there are two different Keycloak URLs below and why that's deliberate,
# not a typo.

# Where gateway CONNECTS to fetch the JWKS — Keycloak's real in-cluster
# Service DNS name. For local dev against a real cluster, port-forward
# Keycloak and point this at localhost instead (you'll also need
# GATEWAY_KEYCLOAK_CA_PATH pointed at a locally-extracted platform-ca.crt,
# or run with verification effectively disabled some other way — see
# bootstrap/keycloak-bootstrap-cli-client.sh for how the CA gets extracted).
GATEWAY_KEYCLOAK_INTERNAL_URL=https://platform-service.keycloak.svc.cluster.local:8443

# What Keycloak actually puts in a token's `iss` claim (governed by
# spec.hostname.hostname, NOT by however you actually reached Keycloak) —
# almost never needs to change even when GATEWAY_KEYCLOAK_INTERNAL_URL does
# for local testing.
GATEWAY_KEYCLOAK_PUBLIC_URL=https://keycloak.platform.local

GATEWAY_KEYCLOAK_REALM=platform

# In-cluster, this is a file mounted from platform-ca-secret (Reflector-
# mirrored into this namespace — see argocd/manifests/cluster-issuer.yaml).
# Locally, point this at wherever you've extracted platform-ca.crt to, or
# leave it pointed at a path that doesn't exist — main.py's
# _keycloak_tls_verify() falls back to the system default trust store in
# that case (fine for local testing against a self-signed cert only if
# you've imported platform-ca some other way; see docs/known-issues.md).
GATEWAY_KEYCLOAK_CA_PATH=/etc/gateway/keycloak-ca/ca.crt

# catalog-service's real in-cluster Service DNS name + port. For local dev,
# point this at a `kubectl port-forward -n catalog-service svc/catalog-service
# 8000:8000` the same way catalog-service's own README documents for direct
# testing.
GATEWAY_CATALOG_SERVICE_URL=http://catalog-service.catalog-service.svc.cluster.local:8000

# Space-separated list of allowed CORS origins — ui-shell-plan.md item 2:
# ui-shell keeps its own Ingress host (app.platform.local) rather than
# gateway growing a second proxy target, so this is needed for real, both
# locally (Vite's default dev port) AND in-cluster (see
# argocd/manifests/gateway.yaml's Deployment, which sets this to
# https://app.platform.local) — unlike catalog-service's same-named
# setting, which is unused in-cluster since a NetworkPolicy means a browser
# never reaches catalog-service directly.
GATEWAY_CORS_ORIGINS=http://localhost:5173

# HS256 signing secret for the short-lived, module-scoped tokens
# app/module_proxy.py mints (ui-shell-plan.md item 8 — the ?token= an
# embedded module UI iframe uses in place of an Authorization header).
# Blank by default: minting refuses with a 503 rather than ever signing
# with an empty key, so GET /modules/{id}/proxy[-token] simply won't work
# locally until you set this. Any string works for local testing — the
# real value is generated fresh by bootstrap/seal-gateway-module-proxy-secret.sh
# (openssl rand -hex 32), not something you'd ever type by hand against a
# real cluster.
GATEWAY_MODULE_PROXY_TOKEN_SECRET=local-dev-only-not-a-real-secret
